# No secrets are required for the sample/demo pipeline.
# Future Massive (Polygon) adapter — do not put real keys in git.
MASSIVE_API_KEY=
# Flat Files S3 keys from Massive Dashboard (not the REST API key)
MASSIVE_S3_ACCESS_KEY=
MASSIVE_S3_SECRET_KEY=
# Future Databento adapter
DATABENTO_API_KEY=
# Bulk Parquet/manifests (Massive history). Example: D:\quant-edge-lab-data
QUANT_EDGE_DATA_ROOT=
